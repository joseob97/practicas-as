$TTL    604800
@       IN      SOA     dns.prod.local. root.prod.local. (
                             2         ; Serial
                        604800         ; Refresh
                         86400         ; Retry
                       2419200         ; Expire
                        604800 )       ; Negative Cache TTL
;
@         IN  NS     dns.prod.local.
dns       IN  A       172.20.0.6
prod      IN  A       172.30.0.6
db        IN  A       172.30.0.7
nginx     IN  A       172.30.0.5
sftp      IN  A       172.30.0.10
mail      IN  A       172.30.0.15
mail      IN  MX 10   mail.prod.local.
apache    IN  A       172.30.0.20
apache    IN  MX 10   apache.prod.local.

