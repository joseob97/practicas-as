$TTL    604800
@       IN      SOA     dns.dev.local. root.dev.local. (
                             2         ; Serial
                        604800         ; Refresh
                         86400         ; Retry
                       2419200         ; Expire
                        604800 )       ; Negative Cache TTL
;
@         IN  NS      dns.dev.local.
dns       IN  A       172.20.0.6
dev       IN  A       172.40.0.5
db        IN  A       172.40.0.6
ssh       IN  A       172.40.0.9
samba     IN  A       172.40.0.10

