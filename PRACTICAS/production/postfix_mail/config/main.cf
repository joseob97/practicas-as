# Parámetros básicos
myhostname = mail.empresa.com
mydomain = empresa.com
myorigin = $mydomain
inet_interfaces = all
inet_protocols = ipv4
mydestination = $myhostname, localhost.$mydomain, localhost

# Red permitida para enviar correo
mynetworks = 127.0.0.0/8 172.30.0.0/24

# No usamos relay externo
relayhost =

# Seguridad básica
smtpd_banner = $myhostname ESMTP
biff = no
append_dot_mydomain = no
readme_directory = no

# Logs más detallados
debug_peer_level = 2

# Cola de correos
recipient_delimiter = +

# Opcional: evita errores con resoluciones
disable_dns_lookups = yes

